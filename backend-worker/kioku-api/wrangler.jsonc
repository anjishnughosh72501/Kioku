{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kioku-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-18",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "routes": [
    {
      "pattern": "api.kioku.app",
      "custom_domain": true,
      "zone_name": "kioku.app"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "kioku-prod",
      "database_id": "9f676303-c8fd-489a-a6ab-777cf0593301",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "ENVIRONMENT": "production",
    "CORS_ORIGINS": "https://kioku.app,https://api.kioku.app"
  },
  "triggers": {
    "crons": ["0 6 * * *"]
  }
}