# Kioku Backend Configuration
# Copy this file to .env and fill in your values

# Server
PORT=4000

# JWT Secret - generate a random string for production
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# If unset, the server auto-generates an ephemeral secret (tokens invalidate on restart).
JWT_SECRET=

# CORS - comma-separated origins allowed to call the API from browsers.
# Leave empty to reflect any origin (native mobile apps ignore CORS). E.g.:
# CORS_ORIGINS=http://localhost:3000,https://retro.example.com

# Google Drive API (required for file storage)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/auth/google/callback
GOOGLE_REFRESH_TOKEN=
GOOGLE_DRIVE_ROOT_FOLDER_ID=
