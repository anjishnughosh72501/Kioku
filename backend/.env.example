# Kioku Backend Configuration
# Copy this file to .env and fill in your values

# Server
PORT=4000

# JWT Secret - MUST be set to a cryptographically secure random string:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Kioku fails closed and refuses to start if JWT_SECRET is missing.
JWT_SECRET=

# Optional Deprecated Legacy Demo Mode (default: false).
# When true, mounts legacy unencrypted Google Drive routes for demo testing.
# Shipped zero-knowledge production releases must leave this false/unset.
LEGACY_DEMO_MODE=false

# CORS - comma-separated origins allowed to call the API from browsers.
# Leave empty to reflect any origin (native mobile apps ignore CORS). E.g.:
# CORS_ORIGINS=http://localhost:3000,https://retro.example.com

# Google Drive API (required for file storage)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/auth/google/callback
GOOGLE_REFRESH_TOKEN=
GOOGLE_DRIVE_ROOT_FOLDER_ID=
